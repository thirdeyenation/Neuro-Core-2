#!/usr/bin/env python3
"""Git pre-commit hook: validate YAML parseability for staged files.

Scope: git-tracked plugin source/config files only.
Excludes: .a0proj/team/ control-plane files (out of scope per HITL directive).
"""
import subprocess
import sys
import yaml

EXCLUDE_PREFIXES = (".a0proj/",)
YAML_EXTENSIONS = (".yaml", ".yml")


def get_staged_files():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True, check=True,
    )
    return [f for f in result.stdout.splitlines() if f]


def is_yaml_file(path):
    return any(path.endswith(ext) for ext in YAML_EXTENSIONS)


def is_excluded(path):
    return any(path.startswith(p) for p in EXCLUDE_PREFIXES)


def validate_yaml(path):
    try:
        with open(path, "r") as f:
            yaml.safe_load(f)
        return None
    except yaml.YAMLError as e:
        return f"{path}: YAML parse error: {e}"
    except OSError as e:
        return f"{path}: file read error: {e}"


def main():
    staged = get_staged_files()
    yaml_files = [f for f in staged if is_yaml_file(f) and not is_excluded(f)]
    if not yaml_files:
        return 0
    errors = [e for e in (validate_yaml(f) for f in yaml_files) if e]
    if errors:
        print("Pre-commit hook: YAML validation failed for staged files:", file=sys.stderr)
        for err in errors:
            print(f"  {err}", file=sys.stderr)
        print("\nFix YAML syntax errors before committing.", file=sys.stderr)
        return 1
    print(f"Pre-commit hook: validated {len(yaml_files)} YAML file(s).")
    return 0


if __name__ == "__main__":
    sys.exit(main())
